generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  transactions Transaction[]
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  descripcion String
  monto       Float
  tipo        String   // 'ingreso' o 'egreso'
  categoria   String
  fecha       DateTime @default(now())
}